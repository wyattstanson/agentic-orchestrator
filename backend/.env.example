# --- LLM provider ---------------------------------------------------------
# Which provider the agent layer uses. One of: groq | echo
# "echo" is a deterministic, no-network fallback used by tests and offline dev.
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys (no card required).
GROQ_API_KEY=

# Models by role — lets the supervisor use a stronger model than specialists.
LLM_MODEL_PLANNER=llama-3.3-70b-versatile
LLM_MODEL_SPECIALIST=llama-3.1-8b-instant
LLM_MODEL_REVIEWER=llama-3.3-70b-versatile

# --- Tool sandbox ---------------------------------------------------------
# Root directory the file_read / file_write / python_exec tools are confined to.
TOOL_WORKSPACE=./_workspace

# Seconds a single python_exec run may take before it is killed.
CODE_EXEC_TIMEOUT=10

# --- Memory ---------------------------------------------------------------
# Working (task-scoped) memory: memory | redis
WORKING_MEMORY=memory
REDIS_URL=

# Long-term semantic memory: local (offline, no deps) | chroma
MEMORY_BACKEND=local
MEMORY_DIR=./_memory

# --- Database (tasks, traces, approvals) ----------------------------------
# Empty -> local SQLite under DATA_DIR (offline, zero setup).
# To use Supabase: Project → Settings → Database → Connection string (URI),
# then prefix the driver. Example:
#   DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
# (or the connection-pooler host on port 6543 for serverless).
DATABASE_URL=
DATA_DIR=./_data
STORE_BACKEND=sql   # sql | file
